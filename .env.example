# Documentation only: the client does not automatically load .env files.
# Optional override of ~/.config/unisender-go/api-key.
# Set this in the environment of the process running the script.
UNISENDER_GO_API_KEY=
# Optional; normally use automatic datacenter routing via goapi:
# UNISENDER_GO_BASE_URL=https://goapi.unisender.ru/ru/transactional/api/v1
